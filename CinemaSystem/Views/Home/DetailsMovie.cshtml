@model Movie

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    <title>@Model.Name</title>
    <link rel="stylesheet" href="~/css/styles.css"/>
    <style>
        .container {
            max-width: 800px;
            margin: 0 auto;
            
            padding: 20px;
            border-radius: 10px;
            text-align: center;
        }
        
        .review-container {
            text-align: right;
        }
        .center-content {
            text-align: center;
        }

        .image-container {
            max-width: 300px;
            margin: 0 auto;
        }

        .image-container img {
            width: 100%;
            height: auto;
            display: block;
            border-radius: 10px;
            box-shadow: 0 0 10px rgba(0,0,0,0.1);
        }

        h2 {
            margin-top: 20px;
        }

        dl {
            text-align: left;
            margin-top: 20px;
        }

        .btn {
            margin: 10px 5px;
        }
    </style>
</head>
<body>
<div class="container">
    <h1>Movie Details</h1>
    <div class="center-content">
        <div class="image-container">
            <img src="@Url.Content("/" + Model.ImagePath)" class="card-img-top" alt="@Model.Name">
        </div>
        <h2>@Model.Name</h2>

        <dl class="row">
            <dt class="col-sm-2">
                @Html.DisplayNameFor(model => model.Name)
            </dt>
            <dd class="col-sm-10">
                @Html.DisplayFor(model => model.Name)
            </dd>
            <dt class="col-sm-2">
                @Html.DisplayNameFor(model => model.ReleaseDate)
            </dt>
            <dd class="col-sm-10">
                @Html.DisplayFor(model => model.ReleaseDate)
            </dd>
            <dt class="col-sm-2">
                Description
            </dt>
            <dd class="col-sm-10">
                @Html.DisplayFor(model => model.Description)
            </dd>
        </dl>


        @foreach (var review in Model.Reviews)
        {
        <div>
            <h3>@review.Rating / 10</h3>
            <p>@review.Comment</p>
        </div>
        }

        <a asp-controller="Home" asp-action="Index" class="btn btn-primary">Back to Main Page</a>
        <a asp-action="ShowTimes" asp-route-id="@Model.Id" class="btn btn-primary">Book a Ticket</a>
    </div>


    <form asp-action="AddReview" asp-controller="Movie" method="post">
        <input type="hidden" name="MovieId" value="@Model.Id"/>
        <label for="rating">Rating:</label>
        <select name="Rating" asp-items="@(new SelectList(Enumerable.Range(1, 10)))"></select>
        <label for="comment">Comment:</label>
        <input name="Comment" type="text"/>
        <input type="submit" value="Submit Review"/>
    </form>
</div>


</body>
</html>