@model IEnumerable<Movie>

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    <title>Movies</title>
    <link rel="stylesheet" href="~/css/styles.css" />
    <style>
        .title-container {
            display: flex;
            justify-content: center;
            margin-bottom: 20px;
        }

        .admin-button {
            position: fixed;
            top: 10px;
            center: 5px;
        }

        .card {
            position: relative;
            overflow: hidden;
            transition: transform 0.3s ease;
        }

        .card:hover {
            transform: scale(1.05); 
        }
    </style>
</head>
<body>
<div class="container">
    <div class="admin-button">
        <a asp-controller="Movie" asp-action="Index" class="btn btn-secondary">Admin</a>
    </div>

    <div class="title-container">
        <h2>Movies</h2>
    </div>

    <div class="row">
        @foreach (var movie in Model)
        {
        <div class="col-md-4">
            <div class="card mb-4 bg-dark text-white"> 
                <img src="@Url.Content(movie.ImagePath)" class="card-img-top" alt="@movie.Name">
                <div class="card-body">
                    <h5 class="card-title text-center">@movie.Name</h5> 
                    <a asp-controller="Home" asp-action="DetailsMovie" asp-route-id="@movie.Id" class="btn btn-primary">View Details</a>
                </div>
            </div>
        </div>
        }
    </div>
</div>
</body>
</html>
