@model IEnumerable<Movie>

<div class="mb-3">
    <a asp-controller="Movie" asp-action="Index" class="btn btn-secondary">Admin</a>
</div>

<h2>Movies</h2>

<div class="row">
    @foreach (var movie in Model)
    {
        <div class="col-md-4">
            <div class="card mb-4">
                <div class="card-body">
                    <h5 class="card-title">@movie.Name</h5>
                    <a asp-controller="Home" asp-action="DetailsMovie" asp-route-id="@movie.Id" class="btn btn-primary">View Details</a>
                </div>
            </div>
        </div>
    }
</div>